# Telegram Bot Credentials
BOT_TOKEN=your_bot_token_here
CHANNEL_ID=@your_channel_or_group_id
THREAD_ID=

# Scheduling
PUBLISH_TIME=08:50
TZ=Europe/Chisinau
DEBUG_MODE=false
DEBUG_INTERVAL_MINUTES=2

# Dedicated Ollama CT IP/URL (change to your Ollama CT IP, e.g. http://192.168.1.50:11434)
OLLAMA_BASE_URL=http://192.168.1.50:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=60.0
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_RETRIES=3
